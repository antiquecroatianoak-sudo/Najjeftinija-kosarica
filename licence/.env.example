# Copy to .env (never commit .env). All variables: docs/DEPLOY.md
LICENCE_ENV=production
# 32+ random characters, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
LICENCE_SECRET_KEY=
# First start only: creates the organization and its admin (password 12+ characters)
LICENCE_ADMIN_ORG=Moja tvrtka d.o.o.
LICENCE_ADMIN_USER=admin
LICENCE_ADMIN_PASSWORD=
# Behind a TLS reverse proxy (Caddy/nginx/Traefik):
LICENCE_TRUST_PROXY=1
LICENCE_HSTS=1
# Optional
LICENCE_RATES_AUTO=1
LICENCE_BACKUP_KEEP=14
LICENCE_LOG_FORMAT=json
